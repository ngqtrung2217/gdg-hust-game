datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Player {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(60)
  code      String   @unique @db.Char(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  scores    Score[]

  @@map("players")
}

model Score {
  id        BigInt   @id @default(autoincrement())
  playerId  BigInt   @map("player_id")
  gameSlug  String   @map("game_slug") @db.VarChar(50)
  score     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameSlug], name: "uq_player_game")
  @@index([playerId], name: "idx_scores_player_id")
  @@index([gameSlug, score(sort: Desc)], name: "idx_scores_game_slug_score")
  @@map("scores")
}
